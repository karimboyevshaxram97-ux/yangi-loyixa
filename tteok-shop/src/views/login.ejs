<%- include('includes/header') %>

<body>
  <div class="auth-page d-flex justify-content-center align-items-center">
    <div class="auth-card">
      <div class="auth-left">
        <div class="auth-logo">떡</div>
        <h1>떡방</h1>
        <p class="auth-lead">관리자 패널에 오신 것을 환영합니다. 왼쪽에서 빠른 요약을 확인하세요.</p>
        <ul class="auth-features">
          <li>✅ 주문 관리</li>
          <li>✅ 상품 추가 및 수정</li>
          <li>✅ 통계 확인</li>
        </ul>
        <p class="auth-note">모든 것이 당신의 손에 달려 있습니다!</p>
      </div>
      <div class="auth-right">
        <form action="/admin/login" method="POST" class="auth-form">
          <div class="auth-form-header">
            <span class="auth-icon">🍡</span>
            <div>
              <h2>관리자 로그인</h2>
              <p>안전하게 로그인하세요</p>
            </div>
          </div>

          <div class="form-group">
            <label>상점 이름</label>
            <input type="text" name="memberNick" class="form-control" placeholder="상점 이름을 입력하세요" required />
          </div>
          
          <div class="form-group">
            <label>비밀번호</label>
            <input type="password" name="memberPassword" class="form-control" placeholder="비밀번호를 입력하세요" required />
          </div>
          
          <button type="submit" class="btn btn-primary btn-block mt-4">로그인</button>
          
          <p class="auth-change text-center mt-3">
            계정이 없으신가요? <a href="/admin/signup">가입하기</a>
          </p>
          <p class="auth-back text-center">
            <a href="/admin/">← 홈으로</a>
          </p>
        </form>
      </div>
    </div>
  </div>
</body>

<%- include('includes/footer') %>