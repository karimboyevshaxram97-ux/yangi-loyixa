<%- include('includes/header') %>

<body>

  <!-- FULL-PAGE HERO -->
  <div class="home-hero">

    <!-- Background image -->
    <% if (shop && shop.memberImage) { %>
      <img
        class="home-hero-img"
        src="/<%= shop.memberImage %>"
        alt="떡방 이미지"
      />
    <% } else { %>
      <div class="home-hero-fallback">
        <span class="emoji">🍡</span>
        <span class="emoji">🍡</span>
        <span class="emoji">🍡</span>
        <span class="emoji">🍡</span>
        <span class="emoji">🍡</span>
        <span class="emoji">🍡</span>
      </div>
    <% } %>

    <!-- Dark overlay -->
    <div class="home-overlay"></div>

    <!-- TOP NAVBAR -->
    <nav class="home-nav">
      <span class="home-nav-brand">🍡 떡방</span>
      <div class="home-nav-links">
        <a href="/admin/" class="home-nav-btn active">홈</a>
        <% if (locals.member) { %>
          <a href="/admin/logout" class="home-nav-btn home-nav-logout"
             onclick="return confirm('로그아웃 하시겠습니까?')">로그아웃</a>
        <% } else { %>
          <a href="/admin/signup" class="home-nav-btn home-nav-signup">회원가입</a>
        <% } %>
      </div>
    </nav>

    <!-- CENTER CONTENT -->
    <div class="home-center">
      <% if (shop && shop.memberImage) { %>
        <img
          class="home-circle-img"
          src="/<%= shop.memberImage %>"
          alt="떡방 로고"
        />
      <% } else { %>
        <div class="home-circle-placeholder">🍡</div>
      <% } %>
      <% if (locals.member && shop && shop.memberNick) { %>
      <h1 class="home-title"><%= shop.memberNick %></h1>
      <% } %>
      <p class="home-subtitle">전통 한국 떡과 건강한 음료</p>
      <% if (locals.member) { %>
        <% if (!(shop && shop.memberImage)) { %>
          <form action="/admin/update-image" method="POST" enctype="multipart/form-data" class="home-upload-form">
            <label class="home-upload-label">
              📷 배경 이미지 업로드
              <input type="file" name="memberImage" accept="image/*" onchange="this.form.submit()">
            </label>
          </form>
        <% } %>
        <a href="/admin/product/all" class="home-cta-btn">제품 관리 →</a>
      <% } else { %>
        <a href="/admin/signup" class="home-cta-btn">시작하기 →</a>
      <% } %>
    </div>

  </div>

  <% if (locals.member && stats) { %>
  <!-- STATS SECTION -->
  <section class="home-stats-section">
    <div class="home-stats-inner">
      <h2 class="home-stats-title">📊 현황 한눈에 보기</h2>
      <div class="home-stats-grid">

        <div class="home-stat-card">
          <div class="home-stat-icon">🍡</div>
          <div class="home-stat-value"><%= stats.products %></div>
          <div class="home-stat-label">판매 중인 제품</div>
          <a href="/admin/product/all" class="home-stat-btn">제품 관리</a>
        </div>

        <div class="home-stat-card">
          <div class="home-stat-icon">📦</div>
          <div class="home-stat-value"><%= stats.orders %></div>
          <div class="home-stat-label">총 주문 수</div>
          <a href="/admin/order/all" class="home-stat-btn">주문 관리</a>
        </div>

        <div class="home-stat-card">
          <div class="home-stat-icon">👥</div>
          <div class="home-stat-value"><%= stats.members %></div>
          <div class="home-stat-label">가입 회원</div>
          <a href="/admin/user/all" class="home-stat-btn">사용자 관리</a>
        </div>

        <div class="home-stat-card">
          <div class="home-stat-icon">📩</div>
          <div class="home-stat-value <%= stats.pendingInquiries > 0 ? 'is-alert' : '' %>"><%= stats.pendingInquiries %></div>
          <div class="home-stat-label">미답변 문의</div>
          <a href="/admin/inquiry/all" class="home-stat-btn">문의 관리<% if (stats.pendingInquiries > 0) { %> (<%= stats.pendingInquiries %>)<% } %></a>
        </div>

      </div>
    </div>
  </section>
  <% } %>


</body>

<%- include('includes/footer') %>
