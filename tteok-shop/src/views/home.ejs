<%- include('includes/header') %>

<body style="margin:0;padding:0;">

  <!-- FULL-PAGE HERO -->
  <div class="home-hero">

    <!-- Background image -->
    <% if (shop && shop.memberImage) { %>
      <img
        class="home-hero-img"
        src="/<%= shop.memberImage %>"
        alt="떡방 이미지"
      />
    <% } else { %>
      <div class="home-hero-fallback">
        <span class="emoji" style="left:8%;  top:20%; animation-duration:4s;  animation-delay:0s;">🍡</span>
        <span class="emoji" style="left:20%; top:65%; animation-duration:5.5s;animation-delay:.8s;">🍡</span>
        <span class="emoji" style="left:40%; top:15%; animation-duration:3.8s;animation-delay:.3s;">🍡</span>
        <span class="emoji" style="left:60%; top:70%; animation-duration:5s;  animation-delay:1.2s;">🍡</span>
        <span class="emoji" style="left:75%; top:25%; animation-duration:4.5s;animation-delay:.5s;">🍡</span>
        <span class="emoji" style="left:88%; top:60%; animation-duration:6s;  animation-delay:1.8s;">🍡</span>
      </div>
    <% } %>

    <!-- Dark overlay -->
    <div class="home-overlay"></div>

    <!-- TOP NAVBAR -->
    <nav class="home-nav">
      <span class="home-nav-brand">🍡 떡방</span>
      <div class="home-nav-links">
        <a href="/admin/" class="home-nav-btn active">홈</a>
        <% if (locals.member) { %>
          <a href="/admin/logout" class="home-nav-btn home-nav-logout"
             onclick="return confirm('로그아웃 하시겠습니까?')">로그아웃</a>
        <% } else { %>
          <a href="/admin/signup" class="home-nav-btn home-nav-signup">회원가입</a>
        <% } %>
      </div>
    </nav>

    <!-- CENTER CONTENT -->
    <div class="home-center">
      <% if (shop && shop.memberImage) { %>
        <img
          class="home-circle-img"
          src="/<%= shop.memberImage %>"
          alt="떡방 로고"
        />
      <% } else { %>
        <div class="home-circle-placeholder">🍡</div>
      <% } %>
      <% if (locals.member && shop && shop.memberNick) { %>
      <h1 class="home-title"><%= shop.memberNick %></h1>
      <% } %>
      <p class="home-subtitle">전통 한국 떡과 건강한 음료</p>
      <% if (locals.member) { %>
        <% if (!(shop && shop.memberImage)) { %>
          <form action="/admin/update-image" method="POST" enctype="multipart/form-data" style="margin-top:4px;">
            <label style="display:inline-flex;align-items:center;gap:8px;padding:12px 28px;border-radius:999px;background:rgba(255,255,255,0.22);border:1.5px dashed rgba(255,255,255,0.6);color:#fff;font-weight:600;font-size:.95rem;cursor:pointer;transition:background .2s;">
              📷 배경 이미지 업로드
              <input type="file" name="memberImage" accept="image/*" style="display:none;" onchange="this.form.submit()">
            </label>
          </form>
        <% } %>
        <a href="/admin/product/all" class="home-cta-btn">제품 관리 →</a>
      <% } else { %>
        <a href="/admin/signup" class="home-cta-btn">시작하기 →</a>
      <% } %>
    </div>

  </div>

  <% if (locals.member && stats) { %>
  <!-- STATS SECTION -->
  <section style="background:#f4f9fd;padding:56px 24px 64px;">
    <div style="max-width:960px;margin:0 auto;">
      <h2 style="text-align:center;color:#1f3250;font-size:1.6rem;font-weight:800;margin-bottom:36px;">📊 현황 한눈에 보기</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:20px;">

        <div style="background:#fff;border-radius:18px;padding:30px 20px 24px;text-align:center;box-shadow:0 4px 24px rgba(0,0,0,0.07);display:flex;flex-direction:column;">
          <div style="font-size:2.6rem;margin-bottom:8px;">🍡</div>
          <div style="font-size:2.2rem;font-weight:900;color:#4f96de;"><%= stats.products %></div>
          <div style="color:#7a9abf;font-size:.9rem;margin-top:4px;margin-bottom:20px;flex:1;">판매 중인 제품</div>
          <a href="/admin/product/all" style="display:block;padding:10px;border-radius:999px;background:linear-gradient(135deg,#4f96de,#8bcfff);color:#fff;font-weight:700;text-decoration:none;font-size:.9rem;">제품 관리</a>
        </div>

        <div style="background:#fff;border-radius:18px;padding:30px 20px 24px;text-align:center;box-shadow:0 4px 24px rgba(0,0,0,0.07);display:flex;flex-direction:column;">
          <div style="font-size:2.6rem;margin-bottom:8px;">📦</div>
          <div style="font-size:2.2rem;font-weight:900;color:#4f96de;"><%= stats.orders %></div>
          <div style="color:#7a9abf;font-size:.9rem;margin-top:4px;margin-bottom:20px;flex:1;">총 주문 수</div>
          <a href="/admin/order/all" style="display:block;padding:10px;border-radius:999px;background:linear-gradient(135deg,#4f96de,#8bcfff);color:#fff;font-weight:700;text-decoration:none;font-size:.9rem;">주문 관리</a>
        </div>

        <div style="background:#fff;border-radius:18px;padding:30px 20px 24px;text-align:center;box-shadow:0 4px 24px rgba(0,0,0,0.07);display:flex;flex-direction:column;">
          <div style="font-size:2.6rem;margin-bottom:8px;">👥</div>
          <div style="font-size:2.2rem;font-weight:900;color:#4f96de;"><%= stats.members %></div>
          <div style="color:#7a9abf;font-size:.9rem;margin-top:4px;margin-bottom:20px;flex:1;">가입 회원</div>
          <a href="/admin/user/all" style="display:block;padding:10px;border-radius:999px;background:linear-gradient(135deg,#4f96de,#8bcfff);color:#fff;font-weight:700;text-decoration:none;font-size:.9rem;">사용자 관리</a>
        </div>

        <div style="background:#fff;border-radius:18px;padding:30px 20px 24px;text-align:center;box-shadow:0 4px 24px rgba(0,0,0,0.07);display:flex;flex-direction:column;">
          <div style="font-size:2.6rem;margin-bottom:8px;">📩</div>
          <% if (stats.pendingInquiries > 0) { %>
          <div style="font-size:2.2rem;font-weight:900;color:#e55353;"><%= stats.pendingInquiries %></div>
          <% } else { %>
          <div style="font-size:2.2rem;font-weight:900;color:#4f96de;"><%= stats.pendingInquiries %></div>
          <% } %>
          <div style="color:#7a9abf;font-size:.9rem;margin-top:4px;margin-bottom:20px;flex:1;">미답변 문의</div>
          <a href="/admin/inquiry/all" style="display:block;padding:10px;border-radius:999px;background:linear-gradient(135deg,#4f96de,#8bcfff);color:#fff;font-weight:700;text-decoration:none;font-size:.9rem;">문의 관리<% if (stats.pendingInquiries > 0) { %> (<%= stats.pendingInquiries %>)<% } %></a>
        </div>

      </div>
    </div>
  </section>
  <% } %>

  <style>
    /* ── HERO WRAPPER ── */
    .home-hero {
      position: relative;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
    }

    /* Background full-cover image */
    .home-hero-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    /* Fallback animated background */
    @keyframes bgShift {
      0%   { background-position: 0% 50%; }
      50%  { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    @keyframes floatEmoji {
      0%   { transform: translateY(0px)   rotate(0deg);   opacity: .7; }
      50%  { transform: translateY(-30px) rotate(8deg);   opacity: 1; }
      100% { transform: translateY(0px)   rotate(0deg);   opacity: .7; }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .home-hero-fallback {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #1a1a6e, #4f96de, #8e44ad, #cdc2d3, #4f96de, #1a1a6e);
      background-size: 300% 300%;
      animation: bgShift 12s ease infinite;
    }

    /* Floating emojis */
    .home-hero-fallback .emoji {
      position: absolute;
      font-size: 2.8rem;
      animation: floatEmoji ease-in-out infinite;
      pointer-events: none;
      user-select: none;
    }

    /* Center content fade-in when no shop */
    .home-center {
      animation: fadeInUp .9s ease both;
    }

    /* Semi-transparent dark overlay */
    .home-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.55) 0%,
        rgba(0, 0, 0, 0.25) 50%,
        rgba(0, 0, 0, 0.60) 100%
      );
    }

    /* ── TOP NAV ── */
    .home-nav {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 22px 40px;
      background: rgba(0, 0, 0, 0.28);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .home-nav-brand {
      font-size: 1.6rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.5px;
    }

    .home-nav-links {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .home-nav-btn {
      padding: 8px 20px;
      border-radius: 999px;
      font-size: 0.95rem;
      font-weight: 600;
      color: #ffffff;
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.25);
      text-decoration: none;
      transition: background 0.2s, transform 0.2s;
    }

    .home-nav-btn:hover {
      background: rgba(255, 255, 255, 0.28);
      color: #ffffff;
      text-decoration: none;
      transform: translateY(-1px);
    }

    .home-nav-btn.active {
      background: rgba(139, 207, 255, 0.55);
      border-color: rgba(139, 207, 255, 0.6);
    }

    .home-nav-logout {
      background: rgba(255, 100, 100, 0.25);
      border-color: rgba(255, 120, 120, 0.4);
    }

    .home-nav-logout:hover {
      background: rgba(255, 100, 100, 0.45);
    }

    .home-nav-signup {
      background: rgba(139, 207, 255, 0.35);
      border-color: rgba(139, 207, 255, 0.55);
    }

    /* ── CENTER CONTENT ── */
    .home-center {
      position: absolute;
      inset: 0;
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0 24px;
      gap: 18px;
    }

    /* Round shop image in center */
    .home-circle-img {
      width: 180px;
      height: 180px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid rgba(255, 255, 255, 0.75);
      box-shadow: 0 12px 48px rgba(0, 0, 0, 0.35);
      margin-bottom: 8px;
    }

    .home-circle-placeholder {
      width: 180px;
      height: 180px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.18);
      border: 4px solid rgba(255, 255, 255, 0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 5rem;
      margin-bottom: 8px;
    }

    .home-title {
      margin: 0;
      font-size: clamp(2.8rem, 6vw, 5.5rem);
      font-weight: 900;
      color: #ffffff;
      text-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
      letter-spacing: -1px;
    }

    .home-subtitle {
      margin: 0;
      font-size: 1.2rem;
      color: rgba(255, 255, 255, 0.85);
      font-weight: 400;
      letter-spacing: 0.5px;
    }

    .home-cta-btn {
      margin-top: 10px;
      padding: 14px 38px;
      border-radius: 999px;
      background: linear-gradient(135deg, #8bcfff 0%, #b6def5 100%);
      color: #1f3250;
      font-weight: 700;
      font-size: 1.05rem;
      text-decoration: none;
      box-shadow: 0 10px 32px rgba(84, 142, 218, 0.45);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .home-cta-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 40px rgba(84, 142, 218, 0.55);
      color: #1f3250;
      text-decoration: none;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 600px) {
      .home-nav {
        padding: 16px 20px;
      }
      .home-nav-brand {
        font-size: 1.2rem;
      }
      .home-nav-btn {
        padding: 6px 14px;
        font-size: 0.85rem;
      }
      .home-circle-img,
      .home-circle-placeholder {
        width: 130px;
        height: 130px;
      }
      .home-circle-placeholder {
        font-size: 3.5rem;
      }
    }
  </style>

</body>

<%- include('includes/footer') %>
