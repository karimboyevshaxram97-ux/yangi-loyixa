<%- include('includes/header') %>

<body>
  <!-- Toast -->
  <div id="appToast">
    <div id="toastHeader">
      <strong id="toastTitle"></strong>
      <button onclick="document.getElementById('appToast').style.display='none'" class="toast-close">&times;</button>
    </div>
    <div id="toastBody"></div>
  </div>

  <div class="container mt-4">
    <nav class="navbar navbar-dark rounded mb-4">
      <a class="navbar-brand" href="/admin/">🍡 떡방</a>
      <div>
        <a href="/admin/" class="btn btn-outline-light btn-sm mr-2">홈</a>
        <a href="/admin/product/all" class="btn btn-outline-light btn-sm mr-2">제품</a>
        <a href="/admin/user/all"    class="btn btn-light btn-sm mr-2">사용자</a>
        <a href="/admin/order/all"   class="btn btn-outline-light btn-sm mr-2">주문</a>
        <span class="nav-badge-wrap">
          <a href="/admin/inquiry/all" class="btn btn-outline-light btn-sm">문의</a>
          <span id="inquiry-badge"></span>
        </span>
        <a href="/admin/logout"      class="btn btn-outline-light btn-sm"
          onclick="return confirm('로그아웃 하시겠습니까?')">로그아웃</a>
      </div>
    </nav>

    <div class="card">
      <div class="card-header text-white">
        <h5 class="mb-0">👥 사용자 목록</h5>
      </div>
      <div class="card-body">
        <table class="table table-hover">
          <thead class="thead-light">
            <tr>
              <th>번호</th>
              <th>사용자명</th>
              <th>전화번호</th>
              <th>상태</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(value, index) { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= value.memberNick %></td>
              <td><%= value.memberPhone %></td>
              <td>
                <select class="form-control form-control-sm member-status"
                  id="<%= value._id %>">
                  <option value="ACTIVE" <%= value.memberStatus === 'ACTIVE' ? 'selected' : '' %>>✅ 활성</option>
                  <option value="BLOCK" <%= value.memberStatus === 'BLOCK' ? 'selected' : '' %>>🚫 차단</option>
                  <option value="DELETE" <%= value.memberStatus === 'DELETE' ? 'selected' : '' %>>🗑 삭제</option>
                </select>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    function showToast(msg, type) {
      const isOk = type !== 'error';
      const toast = document.getElementById('appToast');
      document.getElementById('toastHeader').style.background = isOk ? '#d1e7dd' : '#f8d7da';
      document.getElementById('toastHeader').style.color = isOk ? '#0a3622' : '#842029';
      document.getElementById('toastTitle').textContent = isOk ? '✅ 성공' : '❌ 오류';
      document.getElementById('toastBody').textContent = msg;
      toast.style.display = 'block';
      clearTimeout(toast._t);
      toast._t = setTimeout(() => { toast.style.display = 'none'; }, 3500);
    }

    $(function() {
      $(".member-status").on("change", async function(e) {
        const id = e.target.id;
        const memberStatus = $("#" + id + ".member-status").val();
        try {
          const response = await axios.post("/admin/user/edit", {
            _id: id, memberStatus: memberStatus
          });
          if (!response.data.data) {
            showToast("업데이트에 실패했습니다.", "error");
          } else if (memberStatus === 'DELETE') {
            $(e.target).closest('tr').fadeOut(300, function() { $(this).remove(); });
          } else {
            showToast("사용자 상태가 업데이트되었습니다.", "success");
          }
        } catch(err) {
          showToast("업데이트에 실패했습니다.", "error");
        }
      });
    });
  </script>
</body>

<%- include('includes/footer') %>