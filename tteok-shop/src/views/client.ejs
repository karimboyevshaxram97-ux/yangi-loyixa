<%- include('includes/header') %>

<body class="client-page">

  <!-- NAVBAR -->
  <nav class="client-nav">
    <span class="client-brand">🍡 떡방</span>
    <div class="client-nav-links">
      <a href="#products" class="client-nav-link">제품</a>
      <a href="#inquiry" class="client-nav-link">문의</a>
      <!-- 장바구니 버튼 -->
      <button onclick="openCart()" class="cart-btn">
        🛒 <span id="cart-count">0</span>
      </button>
    </div>
  </nav>

  <!-- CART DRAWER -->
  <div id="cart-overlay" onclick="closeCart()"></div>
  <div id="cart-drawer">
    <div class="cart-drawer-header">
      <h3>🛒 장바구니</h3>
      <button onclick="closeCart()" class="cart-drawer-close">&times;</button>
    </div>

    <div id="cart-items">
      <p id="cart-empty" class="cart-empty-msg">장바구니가 비어 있습니다.</p>
    </div>

    <div class="cart-footer">
      <div class="cart-total-row">
        <span>합계</span>
        <span id="cart-total">₩0</span>
      </div>
      <button onclick="checkout()" class="btn-gradient">주문하기</button>
      <button onclick="clearCart()" class="btn-ghost cart-clear-btn">장바구니 비우기</button>
    </div>
  </div>

  <!-- PAYMENT MODAL -->
  <div id="payment-overlay" class="overlay-center">
    <div class="pay-card">
      <h3 class="pay-title">💳 결제</h3>
      <p class="pay-sub">결제 수단을 선택해 주세요.</p>

      <div class="pm-grid">
        <label id="pm-card"    onclick="selectPM('CREDIT_CARD')" class="pm-option selected">💳 카드</label>
        <label id="pm-kakao"   onclick="selectPM('KAKAO')"       class="pm-option">🟡 카카오페이</label>
        <label id="pm-samsung" onclick="selectPM('SAMSUNG')"     class="pm-option">🔵 삼성페이</label>
        <label id="pm-apple"   onclick="selectPM('APPLE')"       class="pm-option">🍎 애플페이</label>
      </div>

      <div class="pay-summary-row">
        <span>결제 금액</span>
        <span id="pay-amount-label">₩0</span>
      </div>

      <button id="pay-btn" onclick="completePayment()" class="btn-gradient pay-confirm-btn">결제완료</button>
      <button onclick="closePaymentModal()" class="btn-ghost">취소</button>
      <p id="pay-error" class="form-error"></p>
    </div>
  </div>

  <!-- CHECKOUT SUCCESS -->
  <div id="checkout-success" class="overlay-center">
    <div class="success-card">
      <div class="success-emoji">✅</div>
      <h3>결제가 완료되었습니다!</h3>
      <p>주문해 주셔서 감사합니다.<br/>빠르게 준비하겠습니다.</p>
      <button onclick="document.getElementById('checkout-success').style.display='none'" class="success-btn">확인</button>
    </div>
  </div>

  <!-- HERO -->
  <div id="hero">
    <div>
      <div class="hero-emoji">🍡</div>
      <h1>떡방</h1>
      <p>전통 한국 떡과 건강한 음료</p>
      <a href="#products" class="hero-cta">제품 보기 →</a>
    </div>
  </div>

  <!-- PRODUCTS -->
  <section id="products">
    <h2 class="section-title">🍡 제품 목록</h2>
    <div id="product-list">
      <p class="list-msg">로딩 중...</p>
    </div>
  </section>

  <!-- INQUIRY FORM -->
  <section id="inquiry">
    <h2 class="section-title">📩 문의하기</h2>
    <p class="section-sub">궁금하신 점을 남겨주세요. 이메일로 빠르게 답변드립니다.</p>

    <div id="inquiry-success">
      <div class="success-emoji">✅</div>
      <h3>문의가 접수되었습니다!</h3>
      <p>빠른 시일 내에 이메일로 답변 드리겠습니다.<br/>평균 답변 시간: 24시간 이내</p>
      <button onclick="resetInquiry()" class="inquiry-reset-btn">새 문의 작성</button>
    </div>

    <form id="inquiry-form" onsubmit="submitInquiry(event)">
      <div class="form-field">
        <label class="form-label">이름 *</label>
        <input id="inq-name" type="text" class="form-input" placeholder="홍길동" required />
      </div>
      <div class="form-field">
        <label class="form-label">이메일 *</label>
        <input id="inq-email" type="email" class="form-input" placeholder="example@email.com" required />
      </div>
      <div class="form-field">
        <label class="form-label">전화번호</label>
        <input id="inq-phone" type="text" class="form-input" placeholder="010-0000-0000" />
      </div>
      <div class="form-field-lg">
        <label class="form-label">문의 내용 *</label>
        <textarea id="inq-message" class="form-input" rows="5" placeholder="문의 내용을 입력해 주세요..." required></textarea>
      </div>
      <button type="submit" id="inq-btn" class="inquiry-submit-btn">
        문의 제출하기
      </button>
      <p id="inq-error" class="form-error"></p>
    </form>
  </section>

  <script>
    function escapeHTML(value) {
      return String(value ?? '').replace(/[&<>"']/g, function (ch) {
        return {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        }[ch];
      });
    }

    function escapeAttr(value) {
      return escapeHTML(value).replace(/`/g, '&#96;');
    }

    function safeUploadPath(value) {
      const path = String(value ?? '');
      return /^[a-zA-Z0-9_./-]+$/.test(path) ? path : '';
    }

    // ── 장바구니 상태 ──
    let cart = [];
    try {
      cart = JSON.parse(localStorage.getItem('tteok_cart') || '[]');
      if (!Array.isArray(cart)) cart = [];
    } catch (_) {
      cart = [];
      localStorage.removeItem('tteok_cart');
    }

    function saveCart() {
      localStorage.setItem('tteok_cart', JSON.stringify(cart));
      updateCartBadge();
    }

    function updateCartBadge() {
      const total = cart.reduce((s, i) => s + i.qty, 0);
      const badge = document.getElementById('cart-count');
      if (total > 0) {
        badge.textContent = total;
        badge.style.display = 'flex';
      } else {
        badge.style.display = 'none';
      }
    }

    function addToCart(id, name, price) {
      const existing = cart.find(i => i.id === id);
      if (existing) {
        existing.qty += 1;
      } else {
        cart.push({ id, name, price, qty: 1 });
      }
      saveCart();
      showCartToast(name);
    }

    function showCartToast(name) {
      const el = document.getElementById('cart-toast');
      el.textContent = name + ' 담겼습니다 🛒';
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
      setTimeout(() => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(20px)';
      }, 2000);
    }

    function openCart() {
      renderCartItems();
      document.getElementById('cart-overlay').style.display = 'block';
      document.getElementById('cart-drawer').style.display = 'flex';
    }

    function closeCart() {
      document.getElementById('cart-overlay').style.display = 'none';
      document.getElementById('cart-drawer').style.display = 'none';
    }

    function renderCartItems() {
      const container = document.getElementById('cart-items');
      const empty     = document.getElementById('cart-empty');
      const totalEl   = document.getElementById('cart-total');

      if (cart.length === 0) {
        container.innerHTML = '<p class="cart-empty-msg">장바구니가 비어 있습니다.</p>';
        totalEl.textContent = '₩0';
        return;
      }

      let totalPrice = 0;
      container.innerHTML = cart.map((item, idx) => {
        const sub = item.price * item.qty;
        totalPrice += sub;
        const itemName = escapeHTML(item.name);
        const itemPrice = Number(item.price) || 0;
        return `
          <div class="cart-item">
            <div class="cart-item-info">
              <div class="cart-item-name">${itemName}</div>
              <div class="cart-item-meta">₩${itemPrice.toLocaleString()} × ${item.qty}</div>
            </div>
            <div class="cart-item-sub">₩${sub.toLocaleString()}</div>
            <div class="cart-qty">
              <button onclick="changeQty(${idx},-1)" class="qty-btn">−</button>
              <button onclick="changeQty(${idx},1)"  class="qty-btn">+</button>
            </div>
          </div>
        `;
      }).join('');

      totalEl.textContent = '₩' + totalPrice.toLocaleString();
    }

    function changeQty(idx, delta) {
      cart[idx].qty += delta;
      if (cart[idx].qty <= 0) cart.splice(idx, 1);
      saveCart();
      renderCartItems();
    }

    function clearCart() {
      cart = [];
      saveCart();
      renderCartItems();
    }

    // ── 결제 상태 ──
    const PAYMENT_ENABLED = false;
    let currentOrderId  = null;
    let currentAmount   = 0;
    let selectedMethod  = 'CREDIT_CARD';

    function selectPM(method) {
      selectedMethod = method;
      const map = { CREDIT_CARD:'card', KAKAO:'kakao', SAMSUNG:'samsung', APPLE:'apple' };
      ['CREDIT_CARD','KAKAO','SAMSUNG','APPLE'].forEach(m => {
        document.getElementById('pm-' + map[m]).classList.toggle('selected', m === method);
      });
    }

    function closePaymentModal() {
      document.getElementById('payment-overlay').style.display = 'none';
      currentOrderId = null;
    }

    async function checkout() {
      if (cart.length === 0) return;
      if (!PAYMENT_ENABLED) {
        alert('결제 기능은 아직 준비 중입니다.');
        return;
      }

      const items = cart.map(i => ({
        productId:    i.id,
        itemPrice:    i.price,
        itemQuantity: i.qty,
      }));
      const total = cart.reduce((s, i) => s + i.price * i.qty, 0);

      try {
        const res = await axios.post('/order/create', items);
        currentOrderId = res.data._id;
        currentAmount  = res.data.orderTotal;

        clearCart();
        closeCart();

        document.getElementById('pay-amount-label').textContent = '₩' + currentAmount.toLocaleString();
        document.getElementById('pay-error').style.display = 'none';
        document.getElementById('payment-overlay').style.display = 'flex';
      } catch (err) {
        if (err.response && err.response.status === 401) {
          alert('주문하려면 먼저 로그인이 필요합니다.');
        } else {
          alert('주문 처리 중 오류가 발생했습니다. 다시 시도해 주세요.');
        }
      }
    }

    async function completePayment() {
      if (!currentOrderId) return;
      const errEl  = document.getElementById('pay-error');
      errEl.style.display = 'none';
      if (!PAYMENT_ENABLED) {
        errEl.textContent = '결제 기능은 아직 준비 중입니다.';
        errEl.style.display = 'block';
      }
    }

    // ── 제품 목록 불러오기 ──
    async function loadProducts() {
      try {
        const res = await axios.get('/product/all', {
          params: { page: 1, limit: 100, order: 'createdAt' }
        });
        const products = res.data;
        const list = document.getElementById('product-list');

        if (!products || products.length === 0) {
          list.innerHTML = '<p class="list-msg">등록된 제품이 없습니다.</p>';
          return;
        }

        list.innerHTML = products.map(p => {
          const id = escapeAttr(p._id);
          const name = escapeHTML(p.productName);
          const nameAttr = escapeAttr(p.productName);
          const collection = escapeHTML(p.productCollection);
          const price = Number(p.productPrice) || 0;
          const leftCount = Number(p.productLeftCount) || 0;
          const likes = Number(p.productLikes) || 0;
          const imagePath = safeUploadPath(p.productImages && p.productImages[0]);
          const isSoldOut = leftCount <= 0;

          return `
            <div class="product-card">
              ${imagePath
                ? `<img src="/${escapeAttr(imagePath)}" alt="${nameAttr}" class="product-card-img" />`
                : `<div class="product-card-placeholder">🍡</div>`
              }
              <div class="product-card-body">
                <h3>${name}</h3>
                <p class="product-collection">${collection}</p>
                <div class="product-price-row">
                  <span class="product-price">₩${price.toLocaleString()}</span>
                  <span class="product-stock${isSoldOut ? ' out' : ''}">재고: ${leftCount}</span>
                </div>
                <div class="product-like-row">
                  <button class="like-product-btn" data-id="${id}">
                    ❤️ <span id="likes-${id}">${likes}</span>
                  </button>
                </div>
                <button class="add-cart-btn" data-id="${id}" data-name="${nameAttr}" data-price="${price}" ${isSoldOut ? 'disabled' : ''}>
                  ${isSoldOut ? '품절' : '🛒 담기'}
                </button>
              </div>
            </div>
          `;
        }).join('');

        list.querySelectorAll('.add-cart-btn').forEach(btn => {
          btn.addEventListener('click', function () {
            addToCart(this.dataset.id, this.dataset.name, Number(this.dataset.price));
          });
        });

        list.querySelectorAll('.like-product-btn').forEach(btn => {
          btn.addEventListener('click', function (event) {
            likeProduct(event, this.dataset.id);
          });
        });
      } catch (err) {
        document.getElementById('product-list').innerHTML = '<p class="list-msg error">제품을 불러오지 못했습니다.</p>';
      }
    }

    // ── 문의 제출 ──
    async function submitInquiry(e) {
      e.preventDefault();
      const btn = document.getElementById('inq-btn');
      const errEl = document.getElementById('inq-error');
      errEl.style.display = 'none';
      btn.disabled = true;
      btn.textContent = '제출 중...';

      const body = {
        name:    document.getElementById('inq-name').value.trim(),
        email:   document.getElementById('inq-email').value.trim(),
        phone:   document.getElementById('inq-phone').value.trim() || undefined,
        message: document.getElementById('inq-message').value.trim(),
      };

      try {
        await axios.post('/inquiry/create', body);
        document.getElementById('inquiry-form').style.display = 'none';
        document.getElementById('inquiry-success').style.display = 'block';
      } catch (err) {
        errEl.textContent = '제출 중 오류가 발생했습니다. 다시 시도해 주세요.';
        errEl.style.display = 'block';
      } finally {
        btn.disabled = false;
        btn.textContent = '문의 제출하기';
      }
    }

    function resetInquiry() {
      document.getElementById('inquiry-form').reset();
      document.getElementById('inquiry-form').style.display = 'block';
      document.getElementById('inquiry-success').style.display = 'none';
    }

    async function likeProduct(e, productId) {
      e.stopPropagation();
      const btn = e.currentTarget;
      const countEl = document.getElementById('likes-' + productId);
      btn.disabled = true;
      try {
        const res = await axios.post('/product/like/' + productId);
        countEl.textContent = res.data.productLikes;
        btn.style.background = '#fff0f0';
        btn.style.borderColor = '#e57373';
      } catch (err) {
        if (err.response && (err.response.status === 401 || err.response.status === 403)) {
          alert('좋아요를 누르려면 먼저 로그인이 필요합니다.');
        }
      } finally {
        btn.disabled = false;
      }
    }

    loadProducts();
    updateCartBadge();
  </script>

  <!-- Cart toast notification -->
  <div id="cart-toast"></div>

</body>

<%- include('includes/footer') %>
